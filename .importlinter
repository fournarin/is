# Module dependency rules. See docs/architecture (design.md section 2.2).
#
# This file is what turns the project's principles from "an agreement written in
# a document" into "structurally impossible to violate". Relaxing any rule here
# requires a new ADR first. Never edit it quietly: changing one line has the same
# effect as revoking an ADR.

[importlinter]
root_package = pdm
include_external_packages = True


# ─────────────────────────────────────────────────────────────
# Invariant 1 - the highest-leverage rule in the system (design.md section 12)
# ─────────────────────────────────────────────────────────────
[importlinter:contract:llm-build-time-only]
name = llm/ is importable from authoring/ only (ADR-003)
type = forbidden
source_modules =
    pdm.contracts
    pdm.platform
    pdm.signals
    pdm.triggers
    pdm.playbooks
    pdm.retrieval
    pdm.work
    pdm.dispatch
    pdm.sinks
    pdm.sim
    pdm.api
    pdm.workers.runtime
forbidden_modules =
    pdm.llm
# Indirect paths are checked too. Setting allow_indirect_imports here would let
# runtime code reach the LLM through an intermediate module, which is precisely
# what ADR-003 exists to prevent.


# ─────────────────────────────────────────────────────────────
# ADR-001 - layer 3 knows nothing about layer 1
# ─────────────────────────────────────────────────────────────
[importlinter:contract:dispatch-blind-to-triggers]
name = dispatch/ must not import triggers/ (ADR-001, ADR-030)
type = forbidden
source_modules =
    pdm.dispatch
forbidden_modules =
    pdm.triggers
# Possible because work/ copies machine_id, severity, finding_kind and eta onto
# the work order at creation time, so dispatch reads the order rather than the
# Finding (ADR-030).


# ─────────────────────────────────────────────────────────────
# Runtime must not depend on build time
# ─────────────────────────────────────────────────────────────
[importlinter:contract:runtime-not-depend-on-authoring]
name = playbooks/, work/ and dispatch/ must not import authoring/
type = forbidden
source_modules =
    pdm.playbooks
    pdm.work
    pdm.dispatch
forbidden_modules =
    pdm.authoring


# ─────────────────────────────────────────────────────────────
# design.md section 7 - the simulator must run hundreds of scenarios in CI
# ─────────────────────────────────────────────────────────────
[importlinter:contract:sim-touches-domain-only]
name = sim/ may touch only contracts, dispatch, work and platform (ADR-030)
type = forbidden
source_modules =
    pdm.sim
forbidden_modules =
    pdm.baselines
    pdm.signals
    pdm.triggers
    pdm.playbooks
    pdm.retrieval
    pdm.llm
    pdm.authoring
    pdm.sinks
    pdm.api
    pdm.workers
# The tighter form of this rule (sim may touch dispatch/domain but not all of
# dispatch/) becomes expressible once domain.py files exist - added in slice 1.x.


# ─────────────────────────────────────────────────────────────
# ADR-030 - the technical precondition for every rule above
# ─────────────────────────────────────────────────────────────
[importlinter:contract:contracts-is-leaf]
name = contracts/ must not import any other pdm module (ADR-030)
type = forbidden
source_modules =
    pdm.contracts
forbidden_modules =
    pdm.platform
    pdm.signals
    pdm.triggers
    pdm.playbooks
    pdm.retrieval
    pdm.llm
    pdm.authoring
    pdm.work
    pdm.dispatch
    pdm.sinks
    pdm.sim
    pdm.baselines
    pdm.api
    pdm.workers


# ─────────────────────────────────────────────────────────────
# Phase 2's deliverable is a comparison, and a comparison needs an outsider
# ─────────────────────────────────────────────────────────────
[importlinter:contract:baselines-know-nothing-of-dispatch]
name = baselines/ must not import dispatch/ (ADR-046 section 5)
type = forbidden
source_modules =
    pdm.baselines
forbidden_modules =
    pdm.dispatch
    pdm.platform.db
    psycopg
# A baseline written against the interface of the thing it is compared to is not
# a baseline: it is that thing with pieces removed, and the comparison measures
# the pieces rather than the approach. The database is on the list for the same
# reason the simulator keeps the true repair time out of `RoundState` - a policy
# that could read the world outside the round it was handed would have an
# advantage that belongs to the instrument.


# ─────────────────────────────────────────────────────────────
# ADR-026 - the two worker roles must stay separable
# ─────────────────────────────────────────────────────────────
[importlinter:contract:worker-roles-independent]
name = worker-runtime and worker-authoring must not import each other (ADR-026)
type = independence
modules =
    pdm.workers.runtime
    pdm.workers.authoring
# If the two roles imported each other, splitting them into separate processes
# would be meaningless: one entrypoint would drag in the other's dependencies.


# ─────────────────────────────────────────────────────────────
# ADR-030 - invariant 10, now that domain.py and repo.py exist
# ─────────────────────────────────────────────────────────────
[importlinter:contract:domain-touches-no-io]
name = domain.py must not reach the database or a repo (ADR-030, invariant 10)
type = forbidden
source_modules =
    pdm.platform.jobs.domain
    pdm.platform.documents.domain
    pdm.signals.domain
    pdm.signals.feed
    pdm.authoring.domain
    pdm.authoring.drafting
    pdm.playbooks.domain
    pdm.work.domain
    # Loop 1's arithmetic (ADR-066). On the list for the reason dispatch/ is: it
    # is the module that decides what every future shift is priced at, and a
    # version of it that could open a connection could also be a version that
    # writes the estimate it just proposed.
    pdm.work.estimates
    # Loop 2's arithmetic (ADR-067), and on the list for a sharper version of the
    # same reason: the number it proposes is one layer 1 fires on, so a version of
    # it that could open a connection could also be a version that writes a
    # threshold nobody approved.
    pdm.work.thresholds
    pdm.dispatch.domain
    # Not a domain.py by name, and on the list for the same reason: the override
    # record is a type the API builds and the repo writes, and a module that
    # could reach a connection would be the second place layer 3 talks to the
    # database (ADR-059).
    pdm.dispatch.overrides
    pdm.triggers.domain
    pdm.triggers.trend
    pdm.retrieval.domain
    pdm.platform.auth.domain
    pdm.sim.domain
    pdm.sim.scenario
    pdm.sim.engine
    pdm.llm.domain
    pdm.llm.extractive
    pdm.llm.prompt
forbidden_modules =
    pdm.platform.db
    pdm.platform.jobs.repo
    pdm.platform.documents.repo
    pdm.platform.objects
    pdm.retrieval.repo
    pdm.retrieval.vectors
    pdm.platform.auth.repo
    psycopg
# The rule that turns "dispatch() must be a pure function" from an agreement
# into something the build refuses to accept. Extend source_modules as each
# module grows its own domain.py.
#
# platform.objects is on the forbidden side as well as the repos: it is the
# filesystem, which is I/O by another name. A domain module that could reach it
# would be a domain module that reads a fifty-megabyte scan inside a function
# the simulator calls in a loop.


# ─────────────────────────────────────────────────────────────
# ADR-029, ADR-037 - one door to the model server, and it is not in the path
# tiers 1 and 2 run through
# ─────────────────────────────────────────────────────────────
[importlinter:contract:model-server-has-one-door]
name = only llm/server.py may speak to the model server (ADR-029, ADR-037)
type = forbidden
source_modules =
    pdm.llm.domain
    pdm.llm.extractive
    pdm.llm.prompt
    pdm.authoring
forbidden_modules =
    pdm.llm.server
    urllib
# The extractive backend is what every commit runs (ADR-037 section 9). If it
# could reach the server module, a machine with no `llm-server` would fail tier 1
# for a reason that has nothing to do with what changed - and the two backends
# would stop being separable, which is the property that keeps "no silent
# fallback" true.
#
# `authoring/` is on the list because the drafting service takes its backend as
# an argument. The composition root chooses which one; a service that could
# import the HTTP backend directly could also decide to fall back to it.


# ─────────────────────────────────────────────────────────────
# ADR-033 - the measuring instrument is not part of the system
# ─────────────────────────────────────────────────────────────
[importlinter:contract:fixtures-are-not-shipped]
name = src/pdm must not import the fixture corpus (ADR-033)
type = forbidden
source_modules =
    pdm
forbidden_modules =
    fixtures
# The corpus is an answer key and a demo seed. Imported from src/, it would ship
# with the system, and a synthetic manual sitting in the same store as the real
# ones is a page a technician could be served. The docstring said so; this is
# what makes it true.


# ─────────────────────────────────────────────────────────────
# ADR-031 rule 8 - the ORM must not creep back in
# ─────────────────────────────────────────────────────────────
[importlinter:contract:no-orm-in-the-application]
name = src/pdm must not import sqlalchemy or alembic (ADR-031)
type = forbidden
source_modules =
    pdm
forbidden_modules =
    sqlalchemy
    alembic
# Alembic pulls SQLAlchemy in as a transitive dependency, so without this rule
# somebody will eventually notice it is installed and start using it in repo.py,
# one file at a time. Both belong to migrations/ only. Reversing this decision
# should be a deliberate, visible act rather than a slow leak - the same
# reasoning as the network boundary in ADR-029.

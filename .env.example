# Copy to .env before running docker compose. Every key here is referenced by
# docker-compose.yml; nothing is listed "for later".
#
# lessons_carried.md 4.4: config entries with no consumer create expectations
# that nothing backs, and the cost of leaving them shows up at handover. Delete
# a key the moment it stops being read.

POSTGRES_USER=pdm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pdm

# Where the browser reaches the API. Only used by the web container.
API_URL=http://localhost:8000

# Where documents are stored on the API and worker containers. This is the path
# the shared `storage` volume is mounted at; the code has no default, because a
# service writing manuals to a guessed directory looks healthy and loses the
# evidence a closed work order cites (ADR-019).
STORAGE_DIR=/app/storage

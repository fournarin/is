# Copy to .env before running docker compose. Every key here is referenced by
# docker-compose.yml; nothing is listed "for later".
#
# lessons_carried.md 4.4: config entries with no consumer create expectations
# that nothing backs, and the cost of leaving them shows up at handover. Delete
# a key the moment it stops being read.

POSTGRES_USER=pdm
# Keep this URL-safe. It is interpolated into a DSN in docker-compose.yml, so a
# password containing / ? # or @ produces a connection string libpq reads as
# something other than what was written.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pdm

# ── layer 1's signal source (ADR-002, ADR-044) ─────────────────────────────
# Only worker-runtime reads these. `synthetic` generates the twelve-hour demo
# scenario; unset (or `none`) means no trigger loop at all and the worker reaps
# only, which is what a plant deployment waiting on its OPC UA connection should
# do rather than invent its own data.
#
# The process warns at boot when this is synthetic. Do not remove that line: the
# tickets it produces are indistinguishable from real ones on the screen.
SIGNAL_SOURCE=synthetic
# With SIGNAL_SOURCE=replay, the plant's readings as CSV, put in plant-data/
# (see plant-data/README.md):
# SIGNAL_REPLAY_FILE=/app/plant-data/signals.csv
# How much faster than the plant the scenario is read. 60 turns twelve hours of
# degradation into twelve minutes; 1 runs it at plant speed.
SIGNAL_SPEED=60
# Same scenario and seed give the same stream, byte for byte (ADR-032).
SIGNAL_SEED=0
